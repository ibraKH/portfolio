---
import Layout from "../layouts/Layout.astro";
import TechConstellation from "../components/TechConstellation.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import Icon from "../components/Icon.astro";
import "../styles/lab.css";
import { projects } from "../data/projects";
const previews: Record<string, { category: string; summary: string }> = {
  roya: {
    category: "Multimodal AI",
    summary:
      "Object detection, text recognition and location context in one AI application.",
  },
  clip: {
    category: "Vision-language learning",
    summary:
      "Adapting CLIP to recognise images with just a few labelled examples.",
  },
  techlauncher: {
    category: "Scientific software",
    summary:
      "Collaborative scientific software, built with an eight-person team.",
  },
  nanogpt: {
    category: "Language models",
    summary:
      "Three matched GPT models, with a focus on trustworthy evaluation.",
  },
};
const scholarshipPost =
  "https://www.linkedin.com/posts/ibrahimalharthi_%D8%A7%D9%84%D8%AD%D9%85%D8%AF%D9%84%D9%84%D9%87-%D8%AD%D9%85%D8%AF%D8%A7-%D9%83%D8%AB%D9%8A%D8%B1%D8%A7-%D8%B7%D9%8A%D8%A8%D8%A7-%D9%85%D8%A8%D8%A7%D8%B1%D9%83%D8%A7-%D9%81%D9%8A%D9%87-activity-7398401676962963456-0y8H";
---

<Layout>
  <div class="hero-scroll">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-intro">
          <span class="hero-name">Ibrahim Alharthi</span>
          <span class="small-line"></span>
          <span>Machine Learning Engineer</span>
        </p>
        <h1 id="hero-title">
          <span>I build</span>
          <span>machines</span>
          <span>
            that <em class="accent">see.</em>
          </span>
        </h1>
        <p class="hero-discipline">
          Computer Vision <span>/</span> AI Systems
        </p>
      </div>
      <TechConstellation />
    </section>
  </div>
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">01 / Projects</p>
      <h2 id="work-title">
        Selected work<span class="accent">.</span>
      </h2>
    </div>
    {projects.map((project) => (
      <article class:list={["project", `project-${project.slug}`]} data-reveal>
        <div class="project-info">
          <p class="eyebrow">
            {project.number} / {previews[project.slug].category}
          </p>
          <h3 style={`view-transition-name: title-${project.slug}`}>
            <a href={`/work/${project.slug}/`}>{project.title}</a>
          </h3>
          <p class="project-summary">{previews[project.slug].summary}</p>
          <a class="text-link project-link" href={`/work/${project.slug}/`}>
            Read case study <Icon name="arrow-up-right" />
            <span class="sr-only">: {project.title}</span>
          </a>
        </div>
        <div class="visual-link">
          <ProjectVisual {...project} href={`/work/${project.slug}/`} />
        </div>
        <div class="project-detail">
          <span>{project.role}</span>
          <span>{project.fact}</span>
        </div>
      </article>
    ))}
    <details class="archive archive-more">
      <summary>
        More projects <span aria-hidden="true">+</span>
      </summary>
      <div class="archive-links">
        <a class="text-link" href="https://github.com/ibraKH/fullstack-app">
          Full-stack commerce <Icon name="arrow-up-right" />
        </a>
        <a class="text-link" href="https://github.com/ibraKH/imageProcessing">
          Image processing API <Icon name="arrow-up-right" />
        </a>
        <a class="text-link" href="/map/">
          Web learning map <Icon name="arrow-up-right" />
        </a>
      </div>
    </details>
  </section>
  <section
    id="experience"
    class="experience"
    aria-labelledby="experience-title"
  >
    <div class="wrap experience-layout">
      <div data-reveal>
        <p class="eyebrow">02 / Engineering experience</p>
        <h2 id="experience-title">
          Built with teams.
          <br />
          Shipped with care.
        </h2>
      </div>
      <div class="experience-list">
        <article data-reveal>
          <p class="eyebrow">Jul 2025 to Jun 2026 / Canberra</p>
          <h3>Lead Software Engineer</h3>
          <p class="company">
            ANU TechLauncher <span>Capstone engagement</span>
          </p>
          <p>
            Led an eight-person team building a scientific platform for TERN and
            CSIRO. Owned the backend and CI.
          </p>
          <a class="text-link" href="/work/techlauncher/">
            Read the case study <Icon name="arrow-up-right" />
          </a>
        </article>
        <details class="experience-more disclosure">
          <summary>
            Earlier experience <span class="summary-note">2022–2024</span>
            <span aria-hidden="true">+</span>
          </summary>
          <article data-reveal>
            <p class="eyebrow">Feb to Jun 2024 / Riyadh</p>
            <h3>Software Engineer</h3>
            <p class="company">Nortal</p>
            <p>
              Built responsive production interfaces in React and JavaScript,
              working with designers and engineers to turn requirements into
              features people use.
            </p>
          </article>
          <article data-reveal>
            <p class="eyebrow">Jul to Aug 2023 / Taif</p>
            <h3>Computer Engineering Trainee</h3>
            <p class="company">King Fahd Air Base</p>
            <p>
              Worked across networking, IP telephony and maintenance:
              configuring lines, keeping the network running, and tracking down
              hardware and software faults.
            </p>
          </article>
          <article data-reveal>
            <p class="eyebrow">Dec 2022 to Apr 2023 / Remote</p>
            <h3>Freelance Web Developer</h3>
            <p>
              Built and shipped a responsive company website with React and
              Bootstrap, and looked after its SEO from start to finish.
            </p>
          </article>
        </details>
      </div>
    </div>
  </section>
  <section id="about" class="about wrap" aria-labelledby="about-title">
    <div data-reveal>
      <p class="eyebrow">03 / About</p>
      <h2 id="about-title">
        A builder <br />
        at heart<span class="accent">.</span>
      </h2>
    </div>
    <div class="about-copy" data-reveal>
      <p class="large-copy">
        I’m Ibrahim, a machine learning engineer with a background in computer
        engineering and full-stack development.
      </p>
      <details class="disclosure background-details">
        <summary>
          Background &amp; education <span aria-hidden="true">+</span>
        </summary>
        <p>
          I trained as a computer engineer, have worked across the whole stack,
          and spent a year leading an eight-person team through a serious
          software build. The problems I enjoy most are the stubborn ones,
          especially when cracking them takes a whole team.
        </p>
        <div class="education">
          <p class="eyebrow">Education</p>
          <h3>
            Master of Machine Learning
            <br />
            and Computer Vision
          </h3>
          <p>
            Australian National University · 2024 to present
            <br />
            Expected conferral: December 2026
          </p>
          <a class="text-link scholarship" href={scholarshipPost}>
            SDAIA AI Scholarship recipient, 2024
            <span class="sr-only">(LinkedIn post)</span>
            <Icon name="arrow-up-right" />
          </a>
          <h3>
            Bachelor of Engineering
            <br />
            in Computer Engineering
          </h3>
          <p>Taif University · 2018–2023</p>
          <p class="qualification">
            Full Stack JavaScript Developer Nanodegree
            <br />
            Udacity · 2022
          </p>
        </div>
      </details>
      <details class="disclosure skills-details">
        <summary>
          Skills &amp; tools <span aria-hidden="true">+</span>
        </summary>
        <div class="skills-list">
          <a href="/work/clip/">
            <strong>Vision &amp; learning</strong>
            <span>PyTorch, CLIP, YOLO, OpenCV</span>
            <Icon name="arrow-up-right" />
          </a>
          <a href="/work/roya/">
            <strong>AI software systems</strong>
            <span>Python, FastAPI, React</span>
            <Icon name="arrow-up-right" />
          </a>
          <a href="/work/techlauncher/">
            <strong>Engineering ownership</strong>
            <span>TypeScript, PostGIS, Docker, CI/CD</span>
            <Icon name="arrow-up-right" />
          </a>
        </div>
      </details>
      <a class="text-link about-cv" href="/Ibrahim-Alharthi-CV.pdf" download>
        Download CV <Icon name="arrow-down" />
      </a>
    </div>
  </section>
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="eyebrow">04 / Contact</p>
      <h2 id="contact-title" data-reveal>
        Let’s talk<span class="accent">.</span>
      </h2>
      <a class="contact-email" href="mailto:devibrakh@gmail.com">
        devibrakh@gmail.com <Icon name="arrow-up-right" />
      </a>
      <div class="contact-bottom">
        <div>
          <a class="text-link" href="https://github.com/ibraKH">
            GitHub <Icon name="arrow-up-right" />
          </a>
          <a
            class="text-link"
            href="https://www.linkedin.com/in/ibrahimalharthi/"
          >
            LinkedIn <Icon name="arrow-up-right" />
          </a>
          <a class="text-link" href="/Ibrahim-Alharthi-CV.pdf" download>
            Download CV <Icon name="arrow-down" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
