---
import type { Pt } from "./iso";
interface Props {
  base: Pt;
  crown: Pt;
}
const { base, crown } = Astro.props;
---

<ellipse cx={base[0] + 7} cy={base[1] + 3} rx="15" ry="7" fill="#c9d4e2" />
<path d={`M${base[0]} ${base[1]}V${crown[1]}`} stroke="#647f9f" stroke-width="2" />
<circle cx={crown[0]} cy={crown[1]} r="13" fill="#899eb8" stroke="#647f9f" />
<circle cx={crown[0] - 4} cy={crown[1] - 4} r="5" fill="#aebfd4" />
