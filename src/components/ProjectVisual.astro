---
import Roya from "./illustrations/Roya.astro";
import Clip from "./illustrations/Clip.astro";
import Techlauncher from "./illustrations/Techlauncher.astro";
import Nanogpt from "./illustrations/Nanogpt.astro";
import "../styles/illustrations.css";
import "../styles/project-labs.css";
import "../styles/cards.css";
import EmbeddingLab from "./vision/EmbeddingLab.astro";
interface Props {
  slug: string;
  title: string;
  caption: string;
  design: string[];
  stats?: { value: number; label: string }[];
  href?: string;
}
const { slug, title, caption, design, stats, href } = Astro.props;
const Media = href ? "a" : "div";
const illustrations = {
  roya: Roya,
  clip: Clip,
  techlauncher: Techlauncher,
  nanogpt: Nanogpt,
};
const Illustration = illustrations[slug as keyof typeof illustrations];
// These figures run like a live feed, so they loop and offer a pause.
const loops = ["roya"].includes(slug);
---

<figure
  class:list={["project-visual", "visual-" + slug, { "visual-loops": loops }]}
  style={`view-transition-name: visual-${slug}`}
>
  {slug === "clip" ? (
    <EmbeddingLab />
  ) : (
    <Media href={href} class="project-media">
      <Illustration label={`${title}: ${caption}`} />
    </Media>
  )}
  {loops && (
    <label class="illustration-motion-control">
      <input type="checkbox" class="illustration-pause" />
      <span class="sr-only">Pause animation</span>
      <span class="motion-state" aria-hidden="true">
        <i></i>
        <b class="when-playing">Pause</b>
        <b class="when-paused">Play</b>
      </span>
    </label>
  )}
  {stats && (
    <div
      class="evidence-strip"
      aria-label="Project scope, as documented in the case study"
    >
      {stats.map((stat) => (
        <div>
          <strong>
            <span class="sr-only">{stat.value}</span>
            <b data-count={stat.value} aria-hidden="true">
              {stat.value}
            </b>
          </strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  )}
  <figcaption>{caption}</figcaption>
  <details class="visual-notes">
    <summary>
      Read the diagram <span aria-hidden="true">+</span>
    </summary>
    <ol>
      {design.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
    {slug === "clip" && <Illustration label={`${title}: ${caption}`} />}
  </details>
</figure>

<script>
  import { initEvidence } from "../lib/animation/evidence";
  initEvidence();
  import { initProjectDepth } from "../lib/animation/parallax";
  initProjectDepth();
  import { initCardLight } from "../lib/animation/card-light";
  initCardLight();
  // Animate illustrations only while visible; never animate a hidden tab.
  if ("IntersectionObserver" in window) {
    const visible = new Map<Element, boolean>();
    const sync = () =>
      visible.forEach((shown, element) =>
        element.classList.toggle("is-paused", document.hidden || !shown),
      );
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) =>
        visible.set(entry.target, entry.isIntersecting),
      );
      sync();
    });
    document.querySelectorAll(".illustration").forEach((element) => {
      visible.set(element, false);
      element.classList.add("is-paused");
      observer.observe(element);
    });
    document.addEventListener("visibilitychange", sync);
    window.addEventListener("pagehide", (event) => {
      if (event.persisted) return;
      observer.disconnect();
      document.removeEventListener("visibilitychange", sync);
      visible.clear();
    });
  }
</script>
