---
import Roya from "./illustrations/Roya.astro";
import Clip from "./illustrations/Clip.astro";
import Techlauncher from "./illustrations/Techlauncher.astro";
import Nanogpt from "./illustrations/Nanogpt.astro";
import "../styles/illustrations.css";
interface Props {
  slug: string;
  title: string;
  caption: string;
  design: string[];
  href?: string;
}
const { slug, title, caption, design, href } = Astro.props;
const Media = href ? "a" : "div";
const illustrations = {
  roya: Roya,
  clip: Clip,
  techlauncher: Techlauncher,
  nanogpt: Nanogpt,
};
const Illustration = illustrations[slug as keyof typeof illustrations];
---

<figure
  class:list={["project-visual", "visual-" + slug]}
  style={`view-transition-name: visual-${slug}`}
>
  <Media href={href} class="project-media">
    <Illustration label={`${title}: ${caption}`} />
  </Media>
  <figcaption>{caption}</figcaption>
  <details class="visual-notes">
    <summary>
      Read the diagram <span aria-hidden="true">+</span>
    </summary>
    <ol>
      {design.map((step) => (
        <li>{step}</li>
      ))}
    </ol>
  </details>
</figure>

<script>
  // Illustration motion only runs while the figure is on screen.
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) =>
      entries.forEach((entry) =>
        entry.target.classList.toggle("is-paused", !entry.isIntersecting),
      ),
    );
    document
      .querySelectorAll(".illustration")
      .forEach((el) => observer.observe(el));
  }
</script>
