---
import Layout from "../../layouts/Layout.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
const { project, next } = Astro.props;
const cv = "/Ibrahim-Alharthi-CV.pdf";
---

<Layout
  title={`${project.title} | Ibrahim Alharthi`}
  description={project.summary}
>
  <article class="case-study wrap">
    <a class="text-link back-link" href="/#work">
      <span aria-hidden="true">←</span> All work
    </a>
    <header class="case-header">
      <p class="eyebrow">
        {project.number} / {project.category}
      </p>
      <h1>
        {project.title}
        <span class="accent">.</span>
      </h1>
      <p class="case-tagline">{project.tagline}</p>
      <div class="case-meta">
        <div>
          <span class="eyebrow">My role</span>
          <p>{project.role}</p>
        </div>
        <div>
          <span class="eyebrow">Tools &amp; technologies</span>
          <p>{project.stack}</p>
        </div>
      </div>
    </header>
    <ProjectVisual {...project} />
    <div class="case-body">
      <aside>
        <p class="eyebrow">At a glance</p>
        <p class="case-fact">{project.fact}</p>
        <p>{project.factLabel}</p>
        <a class="text-link" href={project.source}>
          {project.sourceLabel} <span aria-hidden="true">↗</span>
        </a>
        {project.source !== cv && (
          <a class="text-link" href={cv}>
            Full CV (PDF) <span aria-hidden="true">↗</span>
          </a>
        )}
      </aside>
      <div class="case-narrative">
        <section>
          <p class="eyebrow">01 / Context</p>
          <h2>The problem</h2>
          <p>{project.problem}</p>
        </section>
        <section>
          <p class="eyebrow">02 / Contribution</p>
          <h2>What I did</h2>
          <p>{project.ownership}</p>
        </section>
        <section>
          <p class="eyebrow">03 / Decisions</p>
          <h2>The approach</h2>
          <p>{project.approach}</p>
          <ol class="architecture" aria-label="How the system fits together">
            {project.design.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p class="diagram-note">How the main pieces fit together.</p>
        </section>
        <section>
          <p class="eyebrow">04 / Evidence</p>
          <h2>What I can show</h2>
          <p>{project.evidence}</p>
        </section>
        <section>
          <p class="eyebrow">05 / Reflection</p>
          <h2>Limits &amp; lessons</h2>
          <p>{project.limitations}</p>
        </section>
      </div>
    </div>
    <a class="next-project" href={`/work/${next.slug}/`}>
      <span class="eyebrow">Next case study</span>
      <span>
        {next.title} <span aria-hidden="true">↗</span>
      </span>
    </a>
  </article>
</Layout>
