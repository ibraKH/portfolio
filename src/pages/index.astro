---
import Layout from "../layouts/Layout.astro";
import VisionStage from "../components/VisionStage.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { projects } from "../data/projects";
---

<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-intro">
        Ibrahim Alharthi <span class="small-line"></span> Machine Learning
        Engineer
      </p>
      <h1 id="hero-title">
        Computer Vision
        <br />
        &amp; <span class="accent">AI Systems.</span>
      </h1>
      <p class="hero-statement">
        I teach software to read images, then build the product around it, from
        the first model experiment to something people can actually use.
      </p>
      <div class="hero-actions">
        <a class="button" href="#work">
          Explore work <span aria-hidden="true">↘</span>
        </a>
        <a class="text-link" href="/Ibrahim-Alharthi-CV.pdf" download>
          Download CV <span aria-hidden="true">↓</span>
        </a>
      </div>
      <p class="hero-note">Half researcher, half full-stack engineer.</p>
    </div>
    <VisionStage />
  </section>
  <section id="work" class="work wrap" aria-labelledby="work-title">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">01 / Selected work</p>
      <h2 id="work-title">
        Things I’ve built<span class="accent">.</span>
      </h2>
      <p>
        Vision, learning,
        <br />
        and the software that holds them together.
      </p>
    </div>
    {projects.map((project) => (
      <article class:list={["project", `project-${project.slug}`]} data-reveal>
        <div class="project-info">
          <p class="eyebrow">
            {project.number} / {project.category}
          </p>
          <h3>
            <a href={`/work/${project.slug}/`}>{project.title}</a>
          </h3>
          <p class="project-summary">{project.summary}</p>
          <p class="project-stack">{project.stack}</p>
          <a class="text-link project-link" href={`/work/${project.slug}/`}>
            Read case study <span aria-hidden="true">↗</span>
            <span class="sr-only">: {project.title}</span>
          </a>
        </div>
        <div class="visual-link">
          <ProjectVisual {...project} href={`/work/${project.slug}/`} />
        </div>
        <div class="project-detail">
          <span>{project.role}</span>
          <span>{project.fact}</span>
        </div>
      </article>
    ))}
    <div class="archive" data-reveal>
      <p class="eyebrow">Earlier explorations</p>
      <a class="text-link" href="https://github.com/ibraKH/fullstack-app">
        Full-stack commerce <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://github.com/ibraKH/imageProcessing">
        Image processing API <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="/map/">
        Web learning map <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section
    id="experience"
    class="experience"
    aria-labelledby="experience-title"
  >
    <div class="wrap experience-layout">
      <div data-reveal>
        <p class="eyebrow">02 / Engineering experience</p>
        <h2 id="experience-title">
          From architecture <br />
          to delivery.
        </h2>
        <p class="section-intro">
          I like owning the hard parts, and I like getting a team to pull them
          together.
        </p>
      </div>
      <div class="experience-list">
        <article data-reveal>
          <p class="eyebrow">Jul 2025 – Jun 2026 / Canberra</p>
          <h3>Lead Software Engineer</h3>
          <p class="company">
            ANU TechLauncher <span>Capstone engagement</span>
          </p>
          <p>
            Led an eight-person team building a collaborative scientific
            platform for TERN and CSIRO. Owned the backend and CI, from
            authentication and geospatial data to real-time collaboration.
          </p>
          <a class="text-link" href="/work/techlauncher/">
            Read the case study <span aria-hidden="true">↗</span>
          </a>
        </article>
        <article data-reveal>
          <p class="eyebrow">Feb – Jun 2024 / Riyadh</p>
          <h3>Software Engineer</h3>
          <p class="company">Nortal</p>
          <p>
            Built responsive production interfaces in React and JavaScript,
            working with designers and engineers to turn requirements into
            features people use.
          </p>
        </article>
        <article data-reveal>
          <p class="eyebrow">Jul – Aug 2023 / Taif</p>
          <h3>Computer Engineering Trainee</h3>
          <p class="company">King Fahd Air Base</p>
          <p>
            Worked across networking, IP telephony and maintenance: configuring
            lines, keeping the network running, and tracking down hardware and
            software faults.
          </p>
        </article>
        <article data-reveal>
          <p class="eyebrow">Dec 2022 – Apr 2023 / Remote</p>
          <h3>Freelance Web Developer</h3>
          <p>
            Built and shipped a responsive company website with React and
            Bootstrap, and looked after its SEO from start to finish.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="capabilities wrap" aria-labelledby="capabilities-title">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">03 / What I bring</p>
      <h2 id="capabilities-title">Depth, with range.</h2>
    </div>
    <div class="capability-list">
      <a href="/work/clip/" data-reveal>
        <span class="eyebrow">01</span>
        <h3>Vision &amp; learning</h3>
        <p>
          PyTorch, CLIP, YOLO, OpenCV.
          <br />
          Taking experiments all the way to working pipelines.
        </p>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/work/roya/" data-reveal>
        <span class="eyebrow">02</span>
        <h3>AI software systems</h3>
        <p>
          Python, FastAPI, React.
          <br />
          Putting models inside applications people can use.
        </p>
        <span aria-hidden="true">↗</span>
      </a>
      <a href="/work/techlauncher/" data-reveal>
        <span class="eyebrow">03</span>
        <h3>Engineering ownership</h3>
        <p>
          TypeScript, PostGIS, Docker, CI/CD.
          <br />
          Designing it, building it with a team, and seeing it shipped.
        </p>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section id="about" class="about wrap" aria-labelledby="about-title">
    <div data-reveal>
      <p class="eyebrow">04 / A little about me</p>
      <h2 id="about-title">
        A builder <br />
        at heart<span class="accent">.</span>
      </h2>
    </div>
    <div class="about-copy" data-reveal>
      <p class="large-copy">
        I’m Ibrahim. I work where machine learning meets software engineering:
        figuring out what a model can really do, then building the thing that
        puts it to work.
      </p>
      <p>
        I trained as a computer engineer, have worked across the whole stack,
        and spent a year leading an eight-person team through a serious software
        build. The problems I enjoy most are the stubborn ones, especially when
        cracking them takes a whole team.
      </p>
      <div class="education">
        <p class="eyebrow">Education</p>
        <h3>
          Master of Machine Learning
          <br />
          and Computer Vision
        </h3>
        <p>
          Australian National University · 2024 to present
          <br />
          Expected conferral: December 2026
        </p>
        <p class="scholarship">
          <span aria-hidden="true">↗</span> SDAIA AI Scholarship recipient, 2024
        </p>
        <h3>
          Bachelor of Engineering
          <br />
          in Computer Engineering
        </h3>
        <p>Taif University · 2018–2023</p>
        <p class="qualification">
          Full Stack JavaScript Developer Nanodegree
          <br />
          Udacity · 2022
        </p>
      </div>
    </div>
  </section>
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <p class="eyebrow">05 / Start a conversation</p>
      <h2 id="contact-title">
        Got a problem worth solving?
        <br />
        <em>Let’s talk.</em>
      </h2>
      <a class="contact-email" href="mailto:devibrakh@gmail.com">
        devibrakh@gmail.com <span aria-hidden="true">↗</span>
      </a>
      <div class="contact-bottom">
        <p>
          Always happy to talk machine learning,
          <br />
          computer vision or a good engineering problem.
        </p>
        <div>
          <a class="text-link" href="https://github.com/ibraKH">
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href="https://www.linkedin.com/in/ibrahimalharthi/"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/Ibrahim-Alharthi-CV.pdf" download>
            Download CV <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
